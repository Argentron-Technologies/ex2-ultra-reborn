#!/bin/sh /etc/rc.common
# Temperature-based fan control (see /usr/sbin/nas-fan)

START=15
STOP=90
USE_PROCD=1

shutdown() {
	# called on reboot/poweroff: tell nas-fan to go quiet instead of full speed
	touch /tmp/nas-fan.shutdown
	stop
}

start_service() {
	rm -f /tmp/nas-fan.shutdown
	procd_open_instance
	procd_set_param command /usr/sbin/nas-fan
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
