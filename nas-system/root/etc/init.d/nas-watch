#!/bin/sh /etc/rc.common
# NAS health monitor with e-mail alerts (see /usr/sbin/nas-watch)

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/nas-watch
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

stop_service() {
	# a deliberate stop/reboot/shutdown is a clean shutdown
	touch /etc/nas-watch.clean
	sync
}
