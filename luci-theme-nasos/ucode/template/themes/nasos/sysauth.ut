{#
 NAS OS theme for LuCI - sign-in page
 Licensed to the public under the Apache License 2.0.
-#}

{% include('header', { blank_page: true }) %}

{%
	const board = ubus.call('system', 'board');
-%}

<main class="nos-login">
	<form class="nos-login-card" method="post">
		<div class="nos-login-brand">
			<span class="nos-logo" aria-hidden="true">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="22" x2="2" y1="12" y2="12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" x2="6.01" y1="16" y2="16"/><line x1="10" x2="10.01" y1="16" y2="16"/></svg>
			</span>
			<span>
				<b>{{ striptags(board?.hostname ?? '?') }}</b>
				<small>{{ striptags(board?.model ?? '') }}</small>
			</span>
		</div>

		<h1>{{ _('Sign in') }}</h1>

		{% if (fuser): %}
		<div class="alert-message error">{{ _('Invalid username and/or password! Please try again.') }}</div>
		{% endif %}

		<label class="nos-field">
			<span>{{ _('Username') }}</span>
			<input name="luci_username" id="luci_username" type="text" autocomplete="username" autocapitalize="off" spellcheck="false" value="{{ entityencode(duser, true) }}">
		</label>
		<label class="nos-field">
			<span>{{ _('Password') }}</span>
			<input name="luci_password" id="luci_password" type="password" autocomplete="current-password" autofocus>
		</label>

		<button type="submit" class="btn cbi-button-positive important">{{ _('Log in') }}</button>

		<div class="nos-login-foot">{{ version.distname }} {{ version.distversion }}</div>
	</form>
</main>

{% include('footer', { blank_page: true }) %}
